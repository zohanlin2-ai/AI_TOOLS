<Window x:Class="AiTerminal.Views.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Terminal" Height="680" Width="960" WindowStartupLocation="CenterScreen"
        PreviewTextInput="TerminalTextInput" PreviewKeyDown="TerminalKeyDown"
        PreviewMouseRightButtonUp="TerminalRightButtonUp">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox x:Name="OutputBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14"/>
  </Grid>
</Window>
